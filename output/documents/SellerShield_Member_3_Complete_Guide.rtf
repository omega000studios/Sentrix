\pard\s0\f0\fs22\keep\sa120\sl270\slmult0 This is a synthetic example. Actual sandbox captures use source sandbox and values fetched and verified by Member 1. Capture is a shared internal contract, not a public unverified HTTP intake endpoint.\par
\pard\s3\f0\fs24\b\sb180\sa100\keepn Message with Member 2 analysis\b0\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn \{\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn   "order_id": "DEMO-CLEAN",\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn   "id": "MSG-guide-1",\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn   "text": "Please ship to my office instead",\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn   "ai_analysis": \{\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn     "intent": "ADDRESS_CHANGE_REQUEST",\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn     "confidence": 0.98,\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn     "quote": "ship to my office instead",\par
\pard\s0\f1\fs18\li120\sa0\sl220\slmult0\keep\keepn     "proposed_address": null\par
